# URL of the deployed Google Apps Script web app that appends feedback
# submissions to the FORMÉ feedback Google Sheet. Deploy the script in
# google-apps-script/Code.gs as a web app ("Execute as: Me", "Who has
# access: Anyone"), then paste the resulting /exec URL below.
#
# Copy this file to .env (or .env.local) and fill in the real value —
# .env is gitignored, so it's never committed.
VITE_FEEDBACK_ENDPOINT=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
